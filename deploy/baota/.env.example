# Template only. The generated deployment ZIP contains an actual random .env.
TZ=Asia/Shanghai
MYSQL_ROOT_PASSWORD=REPLACE_WITH_RANDOM_ROOT_PASSWORD
MYSQL_DATABASE=delta_game
MYSQL_USER=delta_game
MYSQL_PASSWORD=REPLACE_WITH_RANDOM_DB_PASSWORD
SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/delta_game?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=delta_game
# Must equal MYSQL_PASSWORD.
SPRING_DATASOURCE_PASSWORD=REPLACE_WITH_RANDOM_DB_PASSWORD
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_RANDOM_REDIS_PASSWORD
# Must equal REDIS_PASSWORD.
SPRING_DATA_REDIS_PASSWORD=REPLACE_WITH_RANDOM_REDIS_PASSWORD
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_ASCII_CHARACTERS
AES_KEY=REPLACE_16_CHARS!
# Fixed H5 login code for initial testing; this is not SMS verification.
AUTH_H5_LOGIN_CODE=REPLACE_WITH_RANDOM_6_DIGITS
WX_MINIAPP_ENABLED=false
WX_MINIAPP_APPID=
WX_MINIAPP_SECRET=
WX_PAY_ENABLED=false
FILE_UPLOAD_PATH=/www/data/upload
FILE_UPLOAD_URL_PREFIX=/file/
